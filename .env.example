# Public site URL, no trailing slash (canonical, Open Graph, structured data)
VITE_SITE_URL=https://www.your-domain.com
# Zoho Recruit hosted career site URL (leave empty until you have it)
VITE_ZOHO_CAREERS_URL=
# Zoho Recruit web form (candidate application / resume form) URL, from the form's embed code
VITE_ZOHO_APPLY_FORM_URL=
# Set to "true" to embed the Zoho career site in an iframe on /careers
VITE_ZOHO_EMBED=false
# Public contact details (leave empty to hide; none are invented)
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=
